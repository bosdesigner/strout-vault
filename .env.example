# Strout Vault environment. Copy to .env for local development; on Replit add
# each of these in the Secrets tab. Never commit a filled-in .env.

# --- database -----------------------------------------------------------
# Postgres connection string. On Replit this is the Neon production database.
# Locally `npm run db:local` prints the value to use.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/strout_vault

# --- server -------------------------------------------------------------
# Port the single Node process listens on. Replit sets this itself.
PORT=3000
# Public origin of the app, used for absolute links and CORS on uploads,
# e.g. https://strout-vault.replit.app (no trailing slash).
PUBLIC_URL=http://localhost:3000
# Random string (32+ chars) that signs session cookies and presigned local URLs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- login --------------------------------------------------------------
# The single admin login. Produce the bcrypt hash with: npm run hash-password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=$2a$12$replace-with-output-of-npm-run-hash-password

# --- storage ------------------------------------------------------------
# s3    : new uploads go to Cloudflare R2, existing originals are read from Backblaze B2.
# local : files live under ./.data/storage and are served by this app (development and tests only).
STORAGE_DRIVER=local

# Cloudflare R2 (new uploads, proxies). Endpoint is derived from the account id.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Backblaze B2 (full-quality originals already archived). Read-only from this app.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=anotherstory-meeting-vault
B2_REGION=us-west-004

# --- contractor logins (Phase 3) ------------------------------------------
# Magic links are sent with Resend (https://resend.com). Without an API key the
# link is only printed to the server log (fine for local development).
RESEND_API_KEY=
MAIL_FROM=Strout Vault <vault@yourdomain.com>
# Minutes a sign-in link stays valid.
MAGIC_LINK_TTL_MIN=20

# --- tracked phone numbers (Phase 3, Twilio) -----------------------------
# Needed to verify webhook signatures and to fetch call recordings. Numbers are
# bought in the Twilio console; point each one's voice webhook (HTTP POST) at
#   <PUBLIC_URL>/webhooks/twilio/voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- the worker (Phase 4) ---------------------------------------------------
# `npm run worker` runs once: pulls new Zoom cloud recordings into cold storage,
# transcribes what is waiting, and records a report. On Replit it is a second
# Repl deployed as an hourly Scheduled Deployment with the same secrets plus
# WORKER_MODE=1, which makes the shared `npm start` run the worker instead of
# the website (so neither Repl needs its own .replit).
WORKER_MODE=0

# Zoom Server-to-Server OAuth app (read-only scopes: recording:read:admin, user:read:admin).
# Leave empty and the Zoom step is skipped.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Months re-checked behind the sync cursor on every run (Zoom finishes processing late).
ZOOM_SYNC_OVERLAP_MONTHS=3
# First month to sweep when there is no cursor yet (YYYY-MM). Default: the overlap window.
ZOOM_SYNC_FROM=
# Where originals the worker fetches are archived: b2 (default when B2_* is set), r2 or local.
ARCHIVE_STORAGE=

# Groq Whisper for recordings without a Zoom transcript (~$0.04 per audio hour).
# Nothing is sent to Groq unless BOTH are set; the budget is enforced from spend_ledger.
GROQ_API_KEY=
GROQ_MONTHLY_BUDGET_USD=0
GROQ_MODEL=whisper-large-v3-turbo
# zoom: Zoom's own transcript/captions first, Groq only when there is none. groq: always Groq.
TRANSCRIBE_PREFER=zoom

# ffmpeg is needed for Groq transcription (audio downsampling). replit.nix provides it on Replit.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# A run stops starting new work after this many seconds, so hourly runs never overlap.
WORKER_TIME_BUDGET_SEC=3000
# Bytes one run may download from Zoom (default 20 GB); the rest waits for the next run.
WORKER_MAX_BYTES_PER_RUN=21474836480

# --- clips (Phase 5) --------------------------------------------------------
# Claude reads each new transcript for clip-worthy moments (clip_candidates); you approve in the
# app; the worker renders approved ones with ffmpeg into R2 under clips/. Nothing is sent to
# Anthropic unless BOTH are set; the budget is enforced from spend_ledger. Opus 5.5 list price is
# about $4 per million input tokens: roughly 5 cents per hour of transcript.
ANTHROPIC_API_KEY=
SCOUT_MONTHLY_BUDGET_USD=0
SCOUT_MODEL=claude-opus-5-5
SCOUT_EFFORT=medium
# Which sources are worth scouting; client phone calls are not.
SCOUT_SOURCES=zoom,meet,upload
SCOUT_MAX_PER_RUN=20
# vertical = 9:16 centre crop for TikTok/Reels/Shorts; full = the whole frame.
CLIP_FORMAT=vertical
CLIP_PADDING_SEC=1
CLIP_CAPTIONS=1
CLIP_MAX_PER_RUN=10

# --- embeddings + the MCP server (docs/MCP.md) ------------------------------
# Semantic search: transcript chunks are embedded into chunks.embedding (vector(1024)).
#   voyage : Voyage AI voyage-3.5 (1024 dims, ~$0.06 per million tokens; the full ~6M-token
#            backlog is well under $1). Set VOYAGE_API_KEY. https://dash.voyageai.com
#   openai : text-embedding-3-small with dimensions=1024. Set OPENAI_API_KEY.
#   fake   : deterministic, offline; development and tests only.
#   off    : nothing is embedded and search is keyword-only (the default).
EMBEDDING_PROVIDER=off
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Override the model (default voyage-3.5 / text-embedding-3-small).
EMBEDDING_MODEL=
# Recordings embedded per hourly worker run, and parallel requests to the provider.
EMBED_MAX_PER_RUN=50
EMBED_CONCURRENCY=2

# The MCP server answers at <PUBLIC_URL>/mcp (Streamable HTTP). Read tools connect to Postgres as
# the SELECT-only role mcp_reader; propose_update as mcp_proposer (INSERT into review_queue only).
# Create both roles in Neon (README: "MCP roles"), apply db/migrations/0006_mcp.sql, then paste
# each role's connection string here. Required in production: /mcp answers 503 without them.
MCP_READER_DATABASE_URL=
MCP_PROPOSER_DATABASE_URL=
# Tool calls allowed per token per minute.
MCP_RATE_LIMIT_PER_MIN=60
# OAuth 2.1 (Claude.ai custom connectors): access tokens live 1 hour, refresh tokens 30 days and
# rotate on every use, authorization codes 10 minutes. PUBLIC_URL is the issuer (must be https).
OAUTH_ACCESS_TOKEN_TTL_SEC=3600
OAUTH_REFRESH_TOKEN_TTL_SEC=2592000
OAUTH_CODE_TTL_SEC=600

# --- texts + email (docs/MESSAGES.md) ----------------------------------------
# Ben's own identifiers (comma-separated): his messages get speaker OWNER_NAME and are never
# queued as unknown senders. Each connected Gmail account's address counts as his too.
OWNER_PHONES=
OWNER_EMAILS=
# Ben's TikTok/Instagram accounts, "<platform>:<username>" (docs/SOCIAL_DMS.md).
OWNER_HANDLES=tiktok:hemakesbigmoves
OWNER_NAME=Ben
# Where message_routing.yml and message_blocklist.yml live.
MESSAGES_CONFIG_DIR=./config
# 32 random bytes (hex) that encrypt Gmail refresh tokens at rest (AES-256-GCM).
MESSAGES_ENCRYPTION_KEY=
# Google OAuth client (Web application), scope gmail.readonly only.
# Redirect URI: <PUBLIC_URL>/api/messages/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Days the first backfill reaches back (npm run messages:gmail -- --since overrides it).
GMAIL_BACKFILL_DAYS=365
# Instagram DMs (docs/SOCIAL_DMS.md): a Meta app with the Instagram API (Instagram Login).
# Valid OAuth redirect URI: <PUBLIC_URL>/api/messages/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Steps the worker runs when given no --steps; the 10-minute messages deployment sets gmail,instagram,embed.
WORKER_STEPS=
