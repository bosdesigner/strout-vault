# Strout Vault on Replit.
# Workspace: `npm run dev` serves API + client from one process on PORT.
# Deployment: build once, then `npm start` serves dist/ on PORT (the website).
#
# One Repl runs everything: publish it as a Reserved VM with the secret RUN_WORKER=1
# and `npm start` serves the website and runs the worker loops (README step 6).
# Replit writes the deployment type into this file when you publish; if that ever
# conflicts on a pull, keep the Repl's own copy (git checkout --ours .replit).
run = "npm run dev"
entrypoint = "server/index.ts"
modules = ["nodejs-20"]
hidden = [".config", "dist", "node_modules", ".data"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "start"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3000

[nix]
channel = "stable-24_05"
