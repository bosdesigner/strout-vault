{
  "name": "strout-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Private vault of every recorded conversation: transcripts, search, people, companies and projects.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run build:server && npm run build:worker && npm run build:client",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server/index.js --sourcemap",
    "build:worker": "esbuild server/worker/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/worker/index.js --sourcemap",
    "build:client": "vite build",
    "start": "node bin/start.mjs",
    "start:server": "node dist/server/index.js",
    "worker": "node dist/worker/index.js",
    "worker:dev": "tsx server/worker/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "db:local": "tsx scripts/db-local.ts",
    "db:bench": "tsx scripts/bench-search.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.59.0",
    "@uppy/aws-s3": "^4.1.3",
    "@uppy/core": "^4.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.0",
    "esbuild": "^0.24.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "hash-wasm": "^4.11.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.453.0",
    "pg": "^8.13.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  }
}
